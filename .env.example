# ============================================================
# CloudFinOps – Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloudfinops
DB_USER=finops
DB_PASSWORD=finops_dev_password
DB_DRIVER=mysql+pymysql

# ---------- Spring Boot ----------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cloudfinops?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=finops
SPRING_DATASOURCE_PASSWORD=finops_dev_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---------- React Frontend ----------
VITE_API_BASE_URL=http://localhost:8080/api

# ---------- Synthetic Data Generator ----------
GEN_START_DATE=2024-10-01
GEN_END_DATE=2025-09-30
GEN_TARGET_RECORDS=120000
GEN_OUTPUT_DIR=data/raw
GEN_SEED=42

# ---------- Logging ----------
LOG_LEVEL=INFO